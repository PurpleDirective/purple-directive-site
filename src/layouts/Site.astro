---
/**
 * Site.astro — layout for the "The Practice" flagship redesign.
 * Self-hosts fonts (@fontsource) + bundles CSS so the strict CSP in
 * public/_headers (script-src/font-src/style-src 'self') is satisfied
 * with no third-party origins.
 */
import { social } from '../data/social';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/pd.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ChatWidget from '../components/ChatWidget.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = "Compliance-grade software and operations consulting for clinical research sites and CROs.",
  ogImage = "/og-image.png",
  ogType = "website",
} = Astro.props;

const fullTitle = title === "Home" ? "Purple Directive — The standard clinical research runs on" : `${title} — Purple Directive`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// "Ask Purple" widget ships hidden until the Bedrock-backed /api/chat is wired:
// set PUBLIC_CHAT_ENABLED=true in Cloudflare Pages once the AWS Bedrock secrets
// (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) are configured. Avoids launching a
// visibly-broken chat that would 503 on first use.
const chatEnabled = import.meta.env.PUBLIC_CHAT_ENABLED === 'true';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#1e1040" />
  <link rel="icon" type="image/svg+xml" href="/pd-favicon.svg" />
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, Astro.site)} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Purple Directive" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={social.x.handle} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

  <title>{fullTitle}</title>
  <slot name="head" />
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <SiteNav />
  <main id="main">
    <slot />
  </main>
  <SiteFooter />
  {chatEnabled && <ChatWidget />}

  <!-- Shared: robust in-page anchor scroll (native jump gets eaten while the 3D hub sizes the hero) -->
  <script is:inline>
    (function(){
      var NAV=66;
      function go(id){ var el=document.getElementById(id); if(!el) return;
        var y=el.getBoundingClientRect().top+window.pageYOffset-NAV; window.scrollTo({top:y,behavior:'smooth'}); }
      document.addEventListener('click',function(e){
        var a=e.target.closest?e.target.closest('a[href^="#"], a[href^="/#"]'):null; if(!a) return;
        var href=a.getAttribute('href'); var hashIndex=href.indexOf('#'); if(hashIndex<0) return;
        var id=href.slice(hashIndex+1);
        // only intercept if the target exists on THIS page (cross-page /#x falls through to navigation)
        if(id && document.getElementById(id)){ e.preventDefault(); if(history.replaceState) history.replaceState(null,'','#'+id); go(id); }
      });
      if(location.hash.length>1){ var id=location.hash.slice(1);
        window.addEventListener('load',function(){ setTimeout(function(){ go(id); },450); }); }
    })();
  </script>
  <!-- Shared: nav blends into dark heroes, solidifies over light content -->
  <script is:inline>
    (function(){
      var nav=document.querySelector('nav'); if(!nav) return;
      var light=document.querySelectorAll('.section,.proof,.page-head');
      function upd(){ var h=nav.offsetHeight, solid=false;
        light.forEach(function(s){ var r=s.getBoundingClientRect(); if(r.top<h && r.bottom>0) solid=true; });
        nav.classList.toggle('on-light', solid); }
      upd(); window.addEventListener('scroll',upd,{passive:true}); window.addEventListener('resize',upd);
    })();
  </script>

  <!-- PD Analytics: short-link arrival and buy-click join. No cookies.
       A /go/<slug> link lands with #g=<click id>. The id is sent once as
       go_arrival under this visitor's own daily hash, kept for this tab in
       sessionStorage, and removed from the address bar. A click on a /buy/
       link sends buy_click with a fresh join key and adds j=<key> to that
       link; the /buy worker puts the key on the Stripe checkout so the sale
       joins back to this visit. Runs before c.js (which is deferred) and is
       independent of it — this script posts to /api/event directly.
       Contract: PurpleDirective repo, infra/stripe-fulfillment/README.md -->
  <script is:inline>
    (function(){
      var E='https://analytics.purpledirective.com/api/event';
      var A='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
      function send(o){
        try{
          var b=JSON.stringify(o);
          if(navigator.sendBeacon&&navigator.sendBeacon(E,b)) return;
          fetch(E,{method:'POST',body:b,keepalive:true,headers:{'Content-Type':'text/plain'}}).catch(function(){});
        }catch(e){}
      }
      function key(n){
        var v=new Uint8Array(n),r='';
        crypto.getRandomValues(v);
        for(var i=0;i<n;i++) r+=A[v[i]%A.length];
        return r;
      }
      var g=null, m=/^#g=([A-Za-z0-9]{16})$/.exec(location.hash);
      if(m){
        g=m[1];
        try{ sessionStorage.setItem('_pdg',g); }catch(e){}
        send({event:'go_arrival',path:location.pathname,props:{g:g}});
        try{ history.replaceState(history.state,'',location.pathname+location.search); }catch(e){}
      }else{
        try{ g=sessionStorage.getItem('_pdg'); }catch(e){}
      }
      function onClick(ev){
        var a=ev.target&&ev.target.closest?ev.target.closest('a[href]'):null;
        if(!a) return;
        var u; try{ u=new URL(a.href,location.href); }catch(e){ return; }
        var s=/^\/buy\/([a-z0-9-]+)\/?$/.exec(u.pathname);
        if(!s||u.origin!==location.origin) return;
        var j=key(12);
        u.searchParams.set('j',j);
        a.href=u.toString();
        var p={slug:s[1],j:j};
        if(g) p.g=g;
        send({event:'buy_click',path:location.pathname,props:p});
      }
      document.addEventListener('click',onClick,true);
      document.addEventListener('auxclick',onClick,true);
    })();
  </script>
  <!-- pd-analytics v2 client (clicks, scroll depth, engagement time, JS errors,
       failed requests, web vitals, masked session recordings) — replaces
       t.js, which sent the same pageview beacon and would double-count
       pageviews if loaded alongside c.js (both send one on load; Fable
       review on PR #45, 2026-09-25). c.js's pageview fields are t.js-
       compatible, so nothing downstream needs to change. Standard mode —
       this is the marketing site, no patient/tenant data ever reaches it.
       The go_arrival/buy_click inline script above is untouched: it posts
       directly to /api/event and never depended on t.js. -->
  <script defer src="https://analytics.purpledirective.com/c.js"
          data-site="purpledirective.com" data-privacy="standard" data-record="masked"></script>
  <!-- Cloudflare Web Analytics -->
  <script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "be7494dd3df347c1b626566b5b386d91"}'></script>
</body>
</html>
