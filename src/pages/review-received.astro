---
import Site from '../layouts/Site.astro';
---

<Site title="Review received" description="Thank you — your review has been received.">
  <section class="section hero">
    <h1>Thank you. Your review is <span class="accent">in</span>.</h1>
    <p class="subtitle">
      A person checks each review against our <a href="/review-policy">review policy</a> before
      it is published, so it may take a little while to appear.
    </p>
    <div style="margin-top: 2rem; text-align: center;">
      <a href="/" class="back-btn">Back to Home</a>
    </div>
  </section>
</Site>

<style>
  .back-btn {
    display: inline-block;
    color: var(--text-secondary);
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.7rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s;
  }
  .back-btn:hover {
    border-color: var(--purple-primary);
    color: var(--purple-primary);
  }
</style>
