---
import Site from '../layouts/Site.astro';
import { reviewProducts } from '../data/review-products';
---

<Site
  title="Leave a review"
  description="Tell other clinical research sites how a Purple Directive product worked for you."
>
  <!-- Runs before the analytics scripts (they are deferred): a verified-purchase
       token arrives in the fragment (#t=…). Keep it in memory only and remove
       it from the address bar so no script, log or page URL ever sees it. -->
  <script is:inline>
    (function () {
      var t = null;
      try {
        if (location.hash.length > 1) {
          t = new URLSearchParams(location.hash.slice(1)).get('t');
          if (history.replaceState) history.replaceState(null, '', location.pathname + location.search);
        }
      } catch (e) { t = null; }
      window.__pdReviewToken = t || null;
    })();
  </script>

  <section class="section hero">
    <h1>Leave a <span class="accent">review</span></h1>
    <p class="subtitle">
      Tell other research sites how it worked for you. We publish positive and negative reviews alike.
      A person checks each one against our <a href="/review-policy">review policy</a> before it appears.
    </p>
  </section>

  <section class="review-wrap">
    <p id="review-error" class="form-error" role="alert" hidden></p>
    <p id="review-verified" class="form-note" hidden>This review will show as a verified purchase.</p>

    <form class="review-form" id="review-form" novalidate>
      <!-- honeypot: bots fill this; people never see it -->
      <input type="text" name="company_website" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <label><span class="lt">What are you reviewing? <span class="req">*</span></span>
        <select name="target" id="target-select" required>
          <option value="" disabled selected>Select…</option>
          {reviewProducts.map((p) => (
            <optgroup label={p.label}>
              {p.items.map((i) => <option value={`${p.key}|${i.id}`}>{i.label}</option>)}
              <option value={`${p.key}|`}>{p.label} in general</option>
            </optgroup>
          ))}
        </select>
      </label>

      <label><span class="lt">Your rating <span class="req">*</span></span>
        <select name="rating" required>
          <option value="" disabled selected>Select…</option>
          <option value="5">★★★★★ Excellent</option>
          <option value="4">★★★★☆ Good</option>
          <option value="3">★★★☆☆ Okay</option>
          <option value="2">★★☆☆☆ Below par</option>
          <option value="1">★☆☆☆☆ Poor</option>
        </select>
      </label>

      <label>Title
        <input type="text" name="title" maxlength="80" placeholder="Optional" />
      </label>

      <label><span class="lt">Your review <span class="req">*</span></span>
        <textarea name="body" required rows="6" maxlength="2000"
          placeholder="What did you use it for, what worked, and what could be better?"></textarea>
        <small>Please leave out health information and anyone's contact details.</small>
      </label>

      <label><span class="lt">Name shown with your review <span class="req">*</span></span>
        <input type="text" name="display_name" required maxlength="60" placeholder="Name or initials" />
      </label>

      <label>Your email
        <input type="email" name="contact_email" maxlength="254" />
        <small>Optional. Never shown. We use it only about this review and delete it after 90 days.</small>
      </label>

      <label class="consent">
        <input type="checkbox" name="insider" />
        <span>I work for Purple Directive, or have a personal or business connection to it.</span>
      </label>
      <label class="consent">
        <input type="checkbox" name="incentivized" />
        <span>I received something for writing this review, such as a discount or free access.</span>
      </label>

      <button type="submit" class="submit-btn" id="review-submit">Submit review</button>
      <p class="priv-note">
        By submitting, you agree we may publish your review with the name above.
        See our <a href="/review-policy">review policy</a> and <a href="/privacy">privacy policy</a>.
      </p>
    </form>
  </section>
</Site>

<style>
  .review-wrap { max-width: 680px; margin: 0 auto; padding: 0 1rem 3rem; }
  .form-error {
    background: #fdecec; border: 1px solid #e7a3a3; color: #8a1f1f;
    padding: 0.7rem 0.9rem; border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.92rem;
  }
  .form-note {
    background: var(--purple-tint, #ede9fe); color: var(--purple-dark, #4c1d95);
    padding: 0.7rem 0.9rem; border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.92rem;
  }
  .form-error[hidden], .form-note[hidden] { display: none; }
  .review-form { display: flex; flex-direction: column; gap: 1.1rem; }
  .review-form > label { display: flex; flex-direction: column; gap: 0.35rem; font-weight: 600; font-size: 0.95rem; }
  .review-form input, .review-form textarea, .review-form select {
    font: inherit; padding: 0.6rem 0.7rem; border: 1px solid var(--border);
    border-radius: 8px; background: #fff; color: inherit; font-weight: 400;
  }
  .review-form textarea { resize: vertical; }
  .review-form small { font-weight: 400; color: var(--text-secondary); font-size: 0.82rem; }
  .req { color: var(--purple-primary); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .consent { flex-direction: row !important; align-items: flex-start; gap: 0.6rem !important; font-weight: 400 !important; font-size: 0.9rem; }
  .consent input { margin-top: 0.15rem; }
  .priv-note { font-size: 0.85rem; color: var(--text-secondary); }
  .priv-note a { color: var(--purple-primary); }
  .submit-btn {
    align-self: flex-start; margin-top: 0.25rem; cursor: pointer;
    background: var(--purple-primary, #5B21B6); color: #fff; border: none;
    padding: 0.8rem 1.6rem; border-radius: 8px; font-weight: 600; font-size: 1rem;
  }
  .submit-btn:hover { opacity: 0.92; }
  .submit-btn:disabled { opacity: 0.6; cursor: default; }
</style>

<script>
  import { findProduct } from '../data/review-products';

  const ITEM_RE = /^[a-z0-9][a-z0-9._-]{0,99}$/;
  const FALLBACK = 'Something went wrong. Please try again later, or email info@purpledirective.com.';

  const form = document.getElementById('review-form') as HTMLFormElement | null;
  const select = document.getElementById('target-select') as HTMLSelectElement | null;
  const errBox = document.getElementById('review-error');
  const verifiedNote = document.getElementById('review-verified');
  const button = document.getElementById('review-submit') as HTMLButtonElement | null;

  let token: string | null = (window as unknown as { __pdReviewToken?: string | null }).__pdReviewToken || null;

  function showError(msg: string) {
    if (!errBox) return;
    errBox.textContent = msg;
    errBox.hidden = false;
    errBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  function dropToken() {
    token = null;
    if (verifiedNote) verifiedNote.hidden = true;
    if (select) select.disabled = false;
  }

  // Prefill from ?product=&item= (review links from product emails and pages).
  if (select) {
    const params = new URLSearchParams(location.search);
    const product = findProduct(params.get('product'));
    const rawItem = params.get('item') || '';
    if (product) {
      const value = `${product.key}|${ITEM_RE.test(rawItem) ? rawItem : ''}`;
      if (!Array.from(select.options).some((o) => o.value === value) && token) {
        // A verified link for an item this page does not list: keep it exact,
        // because the token is signed for that item.
        const group = select.querySelector(`optgroup[label="${product.label}"]`) || select;
        const opt = document.createElement('option');
        opt.value = value;
        opt.textContent = rawItem;
        group.append(opt);
      }
      if (Array.from(select.options).some((o) => o.value === value)) select.value = value;
    }
    if (token) {
      if (product && select.value) {
        // The token is signed for this product and item, so they cannot change.
        select.disabled = true;
        if (verifiedNote) verifiedNote.hidden = false;
      } else {
        token = null;
      }
    }
  }

  const messages: Record<string, string> = {
    bad_rating: 'Please choose a star rating.',
    body_required: 'Please write your review.',
    body_too_long: 'Your review is too long. Please keep it under 2,000 characters.',
    display_name_required: 'Please add the name to show with your review.',
    display_name_too_long: 'Please keep the name under 60 characters.',
    title_too_long: 'Please keep the title under 80 characters.',
    contact_email_invalid: 'That email address looks wrong. Fix it or leave it blank.',
    unknown_product: 'Please choose what you are reviewing.',
    bad_item: 'Please choose what you are reviewing.',
  };

  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    if (!form || !select || !button) return;
    if (errBox) errBox.hidden = true;

    const fd = new FormData(form);
    const str = (k: string) => String(fd.get(k) ?? '').trim();
    const [product, item] = (select.value || '').split('|');
    const rating = parseInt(str('rating'), 10);

    if (!product) return showError(messages.unknown_product);
    if (!(rating >= 1 && rating <= 5)) return showError(messages.bad_rating);
    if (!str('body')) return showError(messages.body_required);
    if (!str('display_name')) return showError(messages.display_name_required);

    const payload: Record<string, unknown> = {
      product,
      item: item || null,
      rating,
      title: str('title') || null,
      body: str('body'),
      display_name: str('display_name'),
      contact_email: str('contact_email') || null,
      insider: fd.get('insider') !== null,
      incentivized: fd.get('incentivized') !== null,
      company_website: String(fd.get('company_website') ?? ''),
    };
    if (token) payload.token = token;

    button.disabled = true;
    let res: Response;
    let data: { error?: string; field?: string } = {};
    try {
      res = await fetch('/api/reviews/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
      });
      if ((res.headers.get('Content-Type') || '').includes('application/json')) data = await res.json().catch(() => ({}));
    } catch {
      button.disabled = false;
      return showError(FALLBACK);
    }
    button.disabled = false;

    if (res.status === 202) {
      location.assign('/review-received');
      return;
    }
    const code = data.error || '';
    if (res.status === 400) {
      if (code === 'token_expired') {
        dropToken();
        return showError('Your review link has expired, so this review cannot show as a verified purchase. Submit again to post it without that label.');
      }
      if (code === 'token_invalid' || code === 'token_unconfigured') {
        dropToken();
        return showError('We could not check your review link, so this review cannot show as a verified purchase. Submit again to post it without that label.');
      }
      return showError(messages[code] || 'Please check the form and try again.');
    }
    if (res.status === 409) return showError('A review has already been submitted for this order. Thank you.');
    if (res.status === 413) return showError('Your review is too long. Please shorten it and try again.');
    if (res.status === 429) return showError('Too many reviews from your connection just now. Please wait a minute and try again.');
    if (res.status === 403) return showError('Please reload the page and try again.');
    return showError(FALLBACK);
  });
</script>
