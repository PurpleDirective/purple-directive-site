/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.purpledirective.com https://static.cloudflareinsights.com; connect-src 'self' https://analytics.purpledirective.com https://cloudflareinsights.com; img-src 'self' data: https://analytics.purpledirective.com; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# Not for search: confirmation pages. Robots.txt asks well-behaved crawlers to
# stay out; these headers cover the ones that ignore it. (The API's header is set
# in functions/api/_middleware.ts: Pages does not apply this file to Functions.)
/thank-you*
  X-Robots-Tag: noindex, nofollow
/consulting-intake-received*
  X-Robots-Tag: noindex, nofollow
/feedback-received*
  X-Robots-Tag: noindex, nofollow
/review-received*
  X-Robots-Tag: noindex, nofollow
/newsletter-confirm*
  X-Robots-Tag: noindex, nofollow
